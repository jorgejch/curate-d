# Copy to .env (gitignored) and fill in, or mount a 1Password Environment there. docker compose
# and the helper scripts read it.

# Fernet key sealing provider tokens at rest. Generate with:
#   python -c 'from curate_d.providers.crypto import generate_key; print(generate_key())'
CURATE_D_CREDENTIAL_ENCRYPTION_KEY=

# Values for tests/local/pcloud/dev_api.sh. It drives a deployed control plane: curl for the
# API, kubectl exec into the I/O worker for what has no endpoint.
CURATE_D_URL=http://localhost:8000
# Kubernetes namespace of the deployment; the script finds the I/O worker pod in it by label.
CURATE_D_NAMESPACE=your-namespace
# pCloud folder holding the test library (<root>/source) and its destination (<root>/organized).
CURATE_D_TEST_ROOT=/your-pcloud-test-folder
# Optional: the pCloud account to use when more than one is connected.
# CURATE_D_ACCOUNT=

# Password that encrypts the rclone sidecar's remote config (provider tokens) at rest.
# Optional locally: compose falls back to a development value.
CURATE_D_RCLONE_CONFIG_PASS=
