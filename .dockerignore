# Everything the build does not need. Keeping this tight matters more than usual:
# .env would otherwise carry the credential encryption key into an image layer.
.env
.env.*
*.secret

.git
.gitignore
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

tests/
openspec/
ops/
.agents/
.claude/
nimbalyst-local/
compose.yaml
Makefile
